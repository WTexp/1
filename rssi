import numpy as np, matplotlib.pyplot as plt
np.random.seed(4)
d = np.array([1, 3, 5, 10, 15])                          # distance from router (m)
P1 = -40                                                  # RSSI at 1 m (dBm)

def rssi(n, wall=0):                                      # RSSI = P1 - 10*n*log10(d) - wall + shadowing
    return P1 - 10*n*np.log10(d) - wall + np.random.randn(len(d))

los  = rssi(2.5)                                          # line of sight
wall = rssi(3.0, wall=8)                                  # through one wall (extra 8 dB loss)

plt.figure(figsize=(7, 4.5))
plt.plot(d, los, "o-", label="Line of sight")
plt.plot(d, wall, "s-", label="Through a wall")
plt.xlabel("Distance from router (m)"); plt.ylabel("RSSI (dBm)"); plt.grid(alpha=.3); plt.legend()
plt.title("Wi-Fi Signal Strength vs Distance")
plt.tight_layout(); plt.savefig("exp4_rssi.png", dpi=150); plt.show()

print("OBSERVATION TABLE\nDistance(m) | LOS (dBm) | Wall (dBm) | Extra loss (dB)")
for i in range(len(d)): print(f"{d[i]:11d} | {los[i]:9.0f} | {wall[i]:10.0f} | {los[i]-wall[i]:.0f}")
print("Fitted n (LOS) = %.2f, (wall) = %.2f" % tuple(-np.polyfit(np.log10(d), y, 1)[0]/10 for y in (los, wall)))
